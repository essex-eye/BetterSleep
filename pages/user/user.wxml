<view class="container">
  <!-- 顶部用户信息 -->
  <view class="user-header">
    <view class="user-info">
      <image class="user-avatar" src="/assets/images/default-avatar.png"></image>
      <text class="user-name">用户名</text>
      <button class="vip-button">开通会员</button>
    </view>
  </view>

  <!-- 我的设备 -->
  <view class="device-section">
    <view class="device-header">
      <text class="section-title">我的设备</text>
      <text class="status-tag">已连接</text>
    </view>
    <view class="device-content">
      <view class="device-image-container">
        <image class="device-image" src="/assets/images/device.png" mode="aspectFit"></image>
      </view>
      <text class="more-text">更多 ></text>
    </view>
  </view>

  <!-- 睡眠数据统计 -->
  <view class="stats-section">
    <view class="stats-row">
      <view class="stats-item">
        <view class="stats-content">
          <view class="stats-icon-wrap">
            <text class="stats-icon">⌚</text>
            <view class="stats-text">
              <text class="stats-label">平均睡眠时长</text>
              <text class="stats-value">8小时02分</text>
            </view>
          </view>
        </view>
      </view>
      <view class="stats-item">
        <view class="stats-content">
          <view class="stats-icon-wrap">
            <text class="stats-icon">☀️</text>
            <view class="stats-text">
              <text class="stats-label">睡眠质量</text>
              <text class="stats-value">80分</text>
            </view>
          </view>
        </view>
      </view>
    </view>
    <view class="stats-row">
      <view class="stats-item">
        <view class="stats-content">
          <view class="stats-icon-wrap">
            <text class="stats-icon">ℹ️</text>
            <view class="stats-text">
              <text class="stats-label">历史睡眠问题</text>
              <text class="stats-value">3个</text>
            </view>
          </view>
        </view>
      </view>
      <view class="stats-item">
        <view class="stats-content">
          <view class="stats-icon-wrap">
            <text class="stats-icon">🌙</text>
            <view class="stats-text">
              <text class="stats-label">睡眠监测</text>
              <text class="stats-value">3次</text>
            </view>
          </view>
        </view>
      </view>
    </view>
  </view>

  <!-- 评估数据 -->
  <view class="assessment-section">
    <view class="assessment-row">
      <view class="assessment-item">
        <view class="assessment-content">
          <view class="assessment-icon-wrap">
            <text class="assessment-icon">🎯</text>
            <view class="assessment-text">
              <text class="assessment-label">最近认知评估</text>
              <text class="assessment-value">80分</text>
            </view>
          </view>
        </view>
      </view>
      <view class="assessment-item">
        <view class="assessment-content">
          <view class="assessment-icon-wrap">
            <text class="assessment-icon">😊</text>
            <view class="assessment-text">
              <text class="assessment-label">最近情绪评估</text>
              <text class="assessment-value">80分</text>
            </view>
          </view>
        </view>
      </view>
    </view>
    <view class="assessment-row">
      <view class="assessment-item heart-item">
        <view class="assessment-content">
          <view class="assessment-icon-wrap">
            <text class="assessment-icon">❤️</text>
            <view class="assessment-text">
              <text class="assessment-label">最近心理评估</text>
              <text class="assessment-value">90分</text>
            </view>
          </view>
        </view>
      </view>
      <view class="assessment-item empty-item"></view>
    </view>
  </view>

  <!-- 功能列表 -->
  <view class="function-list">
    <view class="function-item" bindtap="navigateToTutorial">
      <text>使用教学</text>
      <text class="arrow">></text>
    </view>
    <view class="function-item" bindtap="navigateToNews">
      <text>消息</text>
      <text class="arrow">></text>
    </view>
    <view class="function-item" bindtap="navigateToCollection">
      <text>收藏</text>
      <text class="arrow">></text>
    </view>
    <view class="function-item" bindtap="navigateToService">
      <text>联系客服</text>
      <text class="arrow">></text>
    </view>
    <view class="function-item" bindtap="navigateToSettings">
      <text>设置</text>
      <text class="arrow">></text>
    </view>
  </view>
</view> 