page {
  height: 100%;
  background: #151f38;
}
.container {
  min-height: 100vh;
  background: #151f38;
  padding: 0 30rpx;
}
.section {
  background: #22305a;
  border-radius: 16rpx;
  margin: 30rpx 0;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.08);
  width: calc(100% - 0rpx);
  overflow: hidden;
}
.item {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  padding: 32rpx 24rpx;
  border-bottom: 1rpx solid #2d406b;
  color: #fff;
  font-size: 32rpx;
  position: relative;
}
.item:last-child {
  border-bottom: none;
}
.item::after {
  content: " ";
  display: inline-block;
  height: 16rpx;
  width: 16rpx;
  border-width: 4rpx 4rpx 0 0;
  border-color: #8f9bb3;
  border-style: solid;
  transform: matrix(0.71, 0.71, -0.71, 0.71, 0, 0);
  position: absolute;
  right: 30rpx;
  top: 50%;
  margin-top: -8rpx;
}
.item-hover {
  background-color: #2d3d6e !important;
}
.arrow {
  display: none;
}
.logout-btn {
  width: 90%;
  margin: 60rpx auto;
  background: #22305a;
  color: #fff;
  font-size: 32rpx;
  border-radius: 16rpx;
  padding: 20rpx 0;
  display: block;
  letter-spacing: 2rpx;
}

.login-btn {
  width: 90%;
  margin: 60rpx auto;
  background: #3A4F87;
  color: #F3D1A7;
  font-size: 32rpx;
  border-radius: 16rpx;
  padding: 20rpx 0;
  display: block;
  letter-spacing: 2rpx;
  font-weight: 500;
}

.btn-hover {
  background-color: #324574 !important;
  opacity: 0.9;
}