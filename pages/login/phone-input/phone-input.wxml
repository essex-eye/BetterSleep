<view class="container">
  <view class="header">
    <view class="title">添加手机号</view>
  </view>

  <view class="form">
    <view class="form-item">
      <view class="form-label">国家/地区</view>
      <view class="form-value country" bindtap="selectCountry">
        <text>{{country}}</text>
        <view class="arrow"></view>
      </view>
    </view>

    <view class="divider"></view>

    <view class="form-item">
      <view class="form-label">手机号</view>
      <view class="form-value phone">
        <text class="country-code">+{{countryCode}}</text>
        <input type="number" value="{{phoneNumber}}" placeholder="填写手机号" bindinput="handlePhoneInput" />
      </view>
    </view>

    <view class="divider"></view>

    <view class="form-item">
      <view class="form-label">验证码</view>
      <view class="form-value code">
        <input type="number" value="{{verifyCode}}" placeholder="填写验证码" bindinput="handleCodeInput" />
        <view class="send-btn {{canSendCode ? '' : 'disabled'}}" bindtap="sendVerifyCode">
          <text wx:if="{{countdown <= 0}}">获取验证码</text>
          <text wx:else>{{countdown}} s</text>
        </view>
      </view>
    </view>
    <view class="error-msg" wx:if="{{verifyError}}">{{errorMsg}}</view>

    <view class="divider"></view>
  </view>

  <view class="save-option">
    <checkbox checked="{{savePhone}}" bindtap="toggleSavePhone"></checkbox>
    <text>保存手机号，下次使用无需再次添加</text>
  </view>

  <view class="status-area">
    <view class="success-icon" wx:if="{{loginSuccess}}">
      <icon type="success" size="24" color="#00a854"></icon>
      <text class="success-text">登录成功</text>
    </view>
  </view>

  <view class="btn-area">
    <button class="confirm-btn {{canSubmit ? 'active' : ''}}" bindtap="handleConfirm">确定</button>
  </view>
</view> 