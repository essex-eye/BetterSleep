.container {
  min-height: 100vh;
  background-color: #0B1424;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  box-sizing: border-box;
  padding: 0;
}

.content {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 0 35rpx;
}

.logo-section {
  margin-top: 15vh;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.logo {
  width: 160rpx;
  height: 160rpx;
  border-radius: 80rpx;
}

.logo-text {
  color: #FFFFFF;
  font-size: 40rpx;
  margin-top: 30rpx;
  font-weight: 500;
}

.login-section {
  width: 100%;
  margin-top: 100rpx;
}

.login-btn {
  width: 50% !important;
  height: 96rpx;
  line-height: 96rpx;
  background: #0C88FE;
  color: #FFFFFF;
  font-size: 32rpx;
  border-radius: 48rpx;
  border: none;
  font-weight: 500;
  margin: 0 auto;
  display: block;
}

.login-btn::after {
  border: none;
}

.register-link {
  text-align: center;
  color: rgba(255, 255, 255, 0.8);
  font-size: 28rpx;
  margin-top: 30rpx;
  margin-bottom: 40rpx;
}

.privacy-section {
  width: 100%;
  padding: 0 0 80rpx;
  box-sizing: border-box;
  text-align: left;
}

.privacy-label {
  display: flex;
  align-items: flex-start;
  justify-content: flex-start;
  padding-left: 0;
}

.privacy-text-container {
  display: flex;
  flex-wrap: wrap;
  align-items: flex-start;
  flex: 1;
  padding-top: 6rpx;
}

.privacy-text {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.6);
  line-height: 36rpx;
  word-break: break-all;
  white-space: normal;
}

.privacy-link {
  font-size: 24rpx;
  color: #0C88FE;
  line-height: 36rpx;
  word-break: break-all;
  white-space: normal;
}

checkbox {
  margin-right: 8rpx;
  margin-top: 0rpx;
  flex-shrink: 0;
  align-self: flex-start;
  vertical-align: top;
}

checkbox .wx-checkbox-input {
  width: 28rpx;
  height: 28rpx;
  border-radius: 50%;
  background: transparent;
  border: 2rpx solid rgba(255, 255, 255, 0.6);
  vertical-align: top;
}

checkbox .wx-checkbox-input.wx-checkbox-input-checked {
  background: #0C88FE;
  border-color: #0C88FE;
}

/* 隐私协议弹窗样式 */
.privacy-popup {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 999;
}

.privacy-popup-mask {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.6);
}

.privacy-popup-content {
  position: absolute;
  left: 0;
  bottom: 0;
  width: 100%;
  background: #FFFFFF;
  border-radius: 30rpx 30rpx 0 0;
  padding: 40rpx;
  box-sizing: border-box;
  animation: slideUp 0.3s ease-out;
}

@keyframes slideUp {
  from {
    transform: translateY(100%);
  }
  to {
    transform: translateY(0);
  }
}

.popup-title {
  font-size: 32rpx;
  color: #333333;
  text-align: center;
  font-weight: 500;
  margin-bottom: 30rpx;
}

.popup-text {
  font-size: 28rpx;
  color: #666666;
  line-height: 1.6;
  text-align: center;
  margin-bottom: 40rpx;
}

.popup-link {
  color: #0C88FE;
  display: inline;
}

.popup-buttons {
  display: flex;
  justify-content: space-between;
  gap: 20rpx;
}

.popup-btn {
  flex: 1;
  height: 88rpx;
  text-align: center;
  border-radius: 30rpx;
  font-size: 32rpx;
  font-weight: 500;
  display: flex;
  justify-content: center;
  align-items: center;
}

.popup-btn.disagree {
  background: #F5F5F5;
  color: #666666;
}

.popup-btn.agree {
  background: #0C88FE;
  color: #FFFFFF;
}

.popup-btn::after {
  border: none;
}

.popup-btn text {
  white-space: normal;
  word-break: break-word;
  line-height: 1.2;
}

/* 手机号获取弹窗样式 */
.phone-popup {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 999;
}

.phone-popup-mask {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.6);
}

.phone-popup-content {
  position: absolute;
  left: 0;
  bottom: 0;
  width: 100%;
  background: #F5F5F5;
  border-radius: 30rpx 30rpx 0 0;
  padding: 40rpx;
  box-sizing: border-box;
  animation: slideUp 0.3s ease-out;
}

/* 左对齐内容容器 */
.phone-popup-content-aligned {
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  margin-bottom: 40rpx;
}

/* 左对齐的头部样式 */
.phone-popup-header-aligned {
  display: flex;
  flex-direction: row;
  align-items: center;
  margin-bottom: 24rpx;
  width: 100%;
}

.phone-popup-logo {
  width: 80rpx;
  height: 80rpx;
  border-radius: 40rpx;
  margin-right: 12rpx;
}

.phone-popup-title {
  font-size: 36rpx;
  color: #333333;
  font-weight: 500;
}

/* 左对齐的描述容器 */
.phone-popup-desc-container-aligned {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  width: 100%;
}

.phone-popup-desc-title {
  font-size: 36rpx; /* 字体减小一点 */
  color: #333333;
  font-weight: bold;
  margin-bottom: 8rpx;
}

.phone-popup-subdesc {
  font-size: 24rpx;
  color: #999999;
}

.phone-popup-tip {
  font-size: 28rpx;
  color: #999999;
  margin-bottom: 40rpx;
}

.wx-phone-section {
  text-align: center;
  margin-bottom: 40rpx;
}

/* 手机号按钮样式 */
.phone-number-btn {
  width: 100% !important;
  background: #FFFFFF !important;
  border: none !important;
  border-radius: 20rpx !important;
  padding: 0 !important;
  margin-bottom: 16rpx;
  display: flex !important;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 100rpx !important;
  box-sizing: border-box;
}

.phone-number-btn::after {
  border: none;
}

.phone-number {
  font-size: 32rpx;
  color: #333333;
  font-weight: normal;
  display: block;
  margin-bottom: 4rpx;
  letter-spacing: 2rpx;
  text-align: center;
}

.wx-phone-number {
  font-size: 40rpx;
  color: #333333;
  font-weight: 500;
  display: block;
  margin-bottom: 12rpx;
}

.wx-phone-tip {
  font-size: 28rpx;
  color: #999999;
  display: block;
}

.wx-phone-guide {
  font-size: 28rpx;
  color: #666666;
  display: block;
  line-height: 1.6;
  margin-bottom: 24rpx;
}

.phone-popup-btns {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  align-items: center;
}

.phone-popup-btn {
  width: 100% !important;
  height: 88rpx;
  line-height: 88rpx;
  background: #F5F5F5 !important;
  color: #333333;
  font-size: 32rpx;
  border-radius: 30rpx;
  border: none;
  font-weight: 500;
}

.phone-popup-btn::after {
  border: none;
}

/* 添加自定义样式容器用于增加间距 */
.other-phone-container {
  margin-top: 24rpx;
}

/* 使用其他号码按钮样式 */
.other-phone-btn {
  padding: 0 !important;
  width: fit-content !important;
  min-width: unset !important;
  height: auto !important;
  line-height: 1.5 !important;
  background: transparent !important;
  color: #0C88FE;
  font-size: 28rpx;
  border: none;
  font-weight: 600;
}

.other-phone-btn::after {
  border: none;
}

.other-phone-btn text {
  white-space: normal;
  word-break: break-word;
  line-height: 1.2;
}

/* 不允许按钮样式 */
.deny-btn {
  width: 100% !important;
  height: 100rpx;
  background: #FFFFFF !important;
  color: #333333;
  font-size: 32rpx;
  border-radius: 20rpx;
  border: none;
  font-weight: normal;
  box-sizing: border-box;
  text-align: center;
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 0;
}

.deny-btn::after {
  border: none;
}

.deny-btn text {
  white-space: normal;
  word-break: break-word;
  line-height: 1.2;
}

.phone-label-green {
  font-size: 24rpx;
  color: #00b26a;
  display: block;
  font-weight: normal;
  line-height: 1;
  text-align: center;
} 